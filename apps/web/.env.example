# ─────────────────────────────────────────────────────────────
# База данных
#
# Прогресс пользователя живёт в Postgres. Контент курса — по-прежнему
# статические JSON в public/content/, в базу он не попадает.
#
# ЛОКАЛЬНО: docker compose up -d (из корня polski-b1) и строка ниже.
# НА VERCEL: Storage → Create Database → Neon → Connect to project.
#            Vercel сам пропишет DATABASE_URL и DATABASE_URL_UNPOOLED.
#            Забрать их себе: vercel env pull apps/web/.env.local
# ─────────────────────────────────────────────────────────────
DATABASE_URL=postgres://polski:polski@localhost:5433/polski

# Только для миграций (drizzle-kit). У Neon это строка без пулера;
# локально не нужна — подставится DATABASE_URL.
DATABASE_URL_UNPOOLED=

# ─────────────────────────────────────────────────────────────
# Сессия
#
# Подписывает httpOnly-cookie, в которой лежит идентификатор
# пользователя. Сгенерировать: openssl rand -base64 32
#
# Смена секрета разлогинивает всех: гостевые сессии без привязанного
# Google-аккаунта при этом теряются вместе с прогрессом.
# ─────────────────────────────────────────────────────────────
SESSION_SECRET=

# ─────────────────────────────────────────────────────────────
# Вход через Google (Google Identity Services)
#
# Нужен, чтобы прогресс подтягивался на другом устройстве. Без него
# приложение работает: сервер выдаёт гостевую сессию, прогресс пишется
# в базу и живёт, пока цела cookie в этом браузере.
#
# Где взять:
#   1. https://console.cloud.google.com/apis/credentials
#   2. Create credentials → OAuth client ID → Web application
#   3. Authorized JavaScript origins — добавить ВСЕ:
#        http://localhost:3000        (разработка)
#        https://<прод>.vercel.app    (продакшен)
#        https://<превью>.vercel.app  (иначе на превью origin_mismatch)
#   4. Redirect URI не нужен: GIS работает без редиректа
#
# Client Secret не нужен и здесь: ID-токен проверяется по публичным
# ключам Google (jose + JWKS), обмена кодом на токен нет.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Какой языковой пакет загружать
NEXT_PUBLIC_COURSE_ID=pl-b1-ru

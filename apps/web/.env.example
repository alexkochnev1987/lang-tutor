# ─────────────────────────────────────────────────────────────
# Вход через Google (Google Identity Services)
#
# Где взять:
#   1. https://console.cloud.google.com/apis/credentials
#   2. Create credentials → OAuth client ID → Web application
#   3. Authorized JavaScript origins:
#        http://localhost:3000          (разработка)
#        https://ваш-домен              (продакшен)
#   4. Скопировать Client ID сюда
#
# Client SECRET здесь НЕ НУЖЕН: поток полностью клиентский,
# бэкенда нет. Секрет понадобится только когда появится сервер.
#
# Если переменная пустая — вход через Google просто скрыт,
# приложение работает полностью локально.
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Какой языковой пакет загружать
NEXT_PUBLIC_COURSE_ID=pl-b1-ru

{
  "name": "polski-b1",
  "version": "0.1.0",
  "private": true,
  "description": "Подготовка к государственному экзамену по польскому языку B1",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "node scripts/sync-content.mjs && pnpm --filter @polski/web dev",
    "build": "node scripts/sync-content.mjs && pnpm --filter @polski/web build",
    "start": "pnpm --filter @polski/web start",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "content": "node scripts/build-curriculum.mjs && node scripts/sync-content.mjs",
    "validate": "node scripts/validate-grammar.mjs && node scripts/build-curriculum.mjs"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  }
}
